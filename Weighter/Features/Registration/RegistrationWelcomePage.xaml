<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Weighter.Features.RegistrationWelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:copyRegisters="clr-namespace:Weighter.Resources.Copy_Registers"
    xmlns:effects="clr-namespace:WhiteCane.Effects;assembly=WhiteCane"
    xmlns:features="clr-namespace:Weighter.Features"
    x:DataType="features:RegistrationWelcomePageViewModel">
    <Grid Padding="16">
        <StackLayout effects:AccessibilityTraits.Traits="Button" VerticalOptions="Center">
            <Label Text="{x:Static copyRegisters:RegistrationRegister.REG_001}" />
            <Label Text="{x:Static copyRegisters:RegistrationRegister.REG_002}" />
        </StackLayout>
        <Button
            Command="{Binding ContinueCommand}"
            Text="{x:Static copyRegisters:RegistrationRegister.REG_003}"
            VerticalOptions="End" />
    </Grid>
</ContentPage>
