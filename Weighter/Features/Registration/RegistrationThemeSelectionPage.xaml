<?xml version="1.0" encoding="utf-8" ?>
<features:BasePage
    x:Class="Weighter.Features.RegistrationThemeSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:features="clr-namespace:Weighter.Features"
    xmlns:ui="clr-namespace:Weighter.UI"
    x:DataType="features:RegistrationThemeSelectionPageViewModel">
    <Grid RowDefinitions="Auto, *">
        <ui:NavigationBar
            Grid.Row="0"
            LeftActionType="Back"
            LeftCommand="{Binding BackCommand}" />
        <VerticalStackLayout Grid.Row="1">
            <ui:TintedImage
                HeightRequest="60"
                Source="{AppThemeBinding Dark='ic_moon',
                                         Light='ic_sun'}"
                TintColor="{AppThemeBinding Dark='White',
                                            Light='Black'}"
                WidthRequest="60" />
            <Switch IsToggled="{Binding IsDarkModeEnabled}" />
        </VerticalStackLayout>
    </Grid>
</features:BasePage>